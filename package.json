{
  "name": "loopback",
  "private": true,
  "version": "1.0.0",
  "description": "A game where the only enemy is you. Every eight seconds time loops, and everything you did comes back.",
  "author": "Luka Lomadze",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "evaluate": "node --disable-warning=ExperimentalWarning scripts/evaluate.ts",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
